  "repository": {
    "comment": {
      "match": "^#.*$",
      "name": "comment.line.number-sign.wreak"
    },
    "stray": {
      "comment": "Column-0 prose outside any block is treated as implicit text.",
      "match": "^\\S.*$",
      "name": "meta.block.text.wreak meta.stray.wreak"
    },
    "header-flags": {
      "patterns": [
        {
          "match": "(?<=\\s|^)(--?[A-Za-z][\\w-]*)(?:(=)|\\s+)?(?:(?<=[=\\s])([^\\s-]\\S*))?",
          "captures": {
            "1": {
              "name": "variable.parameter.flag.wreak"
            },
            "2": {
              "name": "keyword.operator.assignment.wreak"
            },
            "3": {
              "name": "string.unquoted.flag-value.wreak"
            }
          }
        }
      ]
    },
